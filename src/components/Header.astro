<header class='header'>
  <a class='header__logo' href='/'>Klas Näsman</a>
  <nav>
    <div>
      <a href='#about' class='clickable-area'>Om</a>
    </div>
    <div>
      <p class='nav__projects'>Projekt:</p>
      <a href='#selected' class='clickable-area'>Urval</a>
      <a href='#all' class='clickable-area'>Alla</a>
    </div>
  </nav>
</header>

<script>
  document.querySelectorAll<HTMLAnchorElement>('header nav a[href^="#"]').forEach((link) => {
    link.addEventListener("click", (e) => {
      const target = link.hash ? document.querySelector(link.hash) : null;
      if (!target) return;
      e.preventDefault();
      target.scrollIntoView({ behavior: "smooth" });
    });
  });
</script>
